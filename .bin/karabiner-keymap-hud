#!/usr/bin/env bash
set -euo pipefail

# 常駐 JS HUD を show/hide する。初回だけ起動し、以降は即時表示。
# ~/.bin とリポジトリのどちらから呼んでも、同じパスで常駐プログラムを参照する。
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly HUD_JS="${KARABINER_KEYMAP_HUD_JS:-$DOTFILES_DIR/.config/karabiner/scripts/keymap-hud.js}"
readonly HUD_HTML="${KARABINER_KEYMAP_HUD_HTML:-$DOTFILES_DIR/.config/karabiner/scripts/keymap-hud.html}"
readonly LAYERS_JSON="${KARABINER_KEYMAP_LAYERS_JSON:-$DOTFILES_DIR/.config/karabiner/keymap-layers.json}"
readonly STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/karabiner-keymap-hud"
readonly PID_FILE="$STATE_DIR/daemon.pid"
readonly CMD_FILE="$STATE_DIR/command"
readonly LOG_FILE="$STATE_DIR/hud.log"
readonly HIDUTIL="${KARABINER_HUD_HIDUTIL:-/usr/bin/hidutil}"
readonly BATTERY_SWIFT="${KARABINER_TORABO_BATTERY_SWIFT:-$DOTFILES_DIR/.config/karabiner/scripts/torabo-battery.swift}"
readonly BATTERY_PLIST="${KARABINER_TORABO_BATTERY_PLIST:-$DOTFILES_DIR/.config/karabiner/scripts/torabo-battery-Info.plist}"
readonly BATTERY_BIN="$STATE_DIR/torabo-battery"
readonly BATTERY_JSON="$STATE_DIR/torabo-battery.json"
readonly BATTERY_LOCK="$STATE_DIR/torabo-battery.lock"

usage() {
  cat <<'USAGE'
Usage: karabiner-keymap-hud show [jis|external|torabo] | hide | status | start | stop

f + b で使用するキー一覧を表示または非表示にします。
  show        … Torabo 接続中なら Torabo、なければ内蔵 JIS
  show jis    … 常に内蔵 JIS（上・外側ずらし）
  show external … 常に外付けキーボードの従来配列
  show torabo … 常に Torabo-tsuki
Torabo 表示時は直近の電池残量も見出しに出します。
USAGE
}

is_running() {
  local pid
  [[ -f "$PID_FILE" ]] || return 1
  pid="$(<"$PID_FILE")"
  is_hud_process "$pid"
}

is_hud_process() {
  local pid="$1" process_command expected_command
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  process_command="$(ps -ww -p "$pid" -o command= 2>/dev/null)" || return 1
  expected_command="/usr/bin/osascript -l JavaScript $HUD_JS daemon $HUD_HTML $LAYERS_JSON $PID_FILE $CMD_FILE"
  # 保存した番号の再利用に備え、この設定で起動した常駐プログラムの全引数を照合する。
  [[ "$process_command" == "$expected_command" ]]
}

wait_until_ready() {
  local i
  for i in $(seq 1 50); do
    if is_running && [[ -f "$CMD_FILE" ]]; then
      return 0
    fi
    sleep 0.05
  done
  return 1
}

start_daemon() {
  if is_running; then
    return 0
  fi
  mkdir -p "$STATE_DIR"
  : >"$LOG_FILE"
  printf 'idle\n' >"$CMD_FILE"
  /usr/bin/nohup /usr/bin/osascript -l JavaScript "$HUD_JS" \
    daemon "$HUD_HTML" "$LAYERS_JSON" "$PID_FILE" "$CMD_FILE" >>"$LOG_FILE" 2>&1 &
  disown || true
  wait_until_ready || {
    printf '[ERROR] HUD デーモンの起動に失敗しました。詳細: %s\n' "$LOG_FILE" >&2
    exit 1
  }
}

# Bluetooth 利用説明をバイナリに埋め込み、Karabiner 経由でも権限ダイアログを出せるようにする。
compile_battery_bin() {
  local binary_tmp="$1"
  # PATH 上の swiftc/codesign を使い、テストのスタブ差し替えにも対応する。
  swiftc -module-cache-path "$STATE_DIR/swift-cache" -O "$BATTERY_SWIFT" -o "$binary_tmp" \
    -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker "$BATTERY_PLIST" || return 1
  # 安定した識別子で署名し、Privacy の Bluetooth 一覧に残りやすくする。
  codesign --force --sign - --identifier jp.k-mass.torabo-battery "$binary_tmp" || return 1
}

# ビルドと取得を別プロセスで行い、取得結果を一度に置き換える。
# 失敗時は直近の成功結果を残し、Abort（権限不足）でも表示が空に戻らないようにする。
refresh_battery_async() {
  (
    mkdir "$BATTERY_LOCK" 2>/dev/null || exit 0
    local binary_tmp="" output_tmp=""
    trap 'rm -f -- "$binary_tmp" "$output_tmp"; rmdir "$BATTERY_LOCK"' EXIT
    trap 'exit 1' HUP INT TERM
    [[ -f "$BATTERY_SWIFT" && -f "$BATTERY_PLIST" ]] || exit 0
    if [[ ! -x "$BATTERY_BIN" || "$BATTERY_SWIFT" -nt "$BATTERY_BIN" || "$BATTERY_PLIST" -nt "$BATTERY_BIN" ]]; then
      binary_tmp="$(mktemp "$STATE_DIR/torabo-battery-bin.XXXXXX")" || exit 1
      compile_battery_bin "$binary_tmp" || exit 1
      mv -f "$binary_tmp" "$BATTERY_BIN" || exit 1
      binary_tmp=""
    fi
    output_tmp="$(mktemp "$STATE_DIR/torabo-battery-data.XXXXXX")" || exit 1
    if "$BATTERY_BIN" >"$output_tmp" 2>>"$LOG_FILE"; then
      mv -f "$output_tmp" "$BATTERY_JSON"
      output_tmp=""
    else
      printf '[battery] read failed (exit %s); keeping previous cache if any\n' "$?" >>"$LOG_FILE"
    fi
  ) </dev/null >>"$LOG_FILE" 2>&1 &
  disown || true
}

show_hud() {
  local mode="${1:-auto}"
  start_daemon

  case "$mode" in
    jis)
      # 常駐デーモンは show / show torabo を見る。JIS強制は show を書く。
      printf 'show\n' >"$CMD_FILE"
      return
      ;;
    external)
      printf 'show external\n' >"$CMD_FILE"
      return
      ;;
  esac

  # 自動選択でToraboが見つからないときは内蔵JISを表示する。
  local connection
  connection="$(torabo_connection)" || connection=""
  if [[ "$mode" == auto && -z "$connection" ]]; then
    printf 'show\n' >"$CMD_FILE"
    return
  fi
  printf 'show torabo\n' >"$CMD_FILE"
  if [[ "$connection" == zmk-ble ]]; then
    refresh_battery_async
  fi
}

torabo_connection() {
  local devices
  # USB と Bluetooth で共通の機器番号を使い、トラックボールだけの項目は数えない。
  devices="$("$HIDUTIL" list --matching '{"VendorID":65261,"ProductID":48301,"PrimaryUsagePage":1,"PrimaryUsage":6}' 2>/dev/null)" ||
    return 1
  /usr/bin/awk '
    tolower($1) == "0xfeed" && tolower($2) == "0xbcad" && $4 == "1" && $5 == "6" {
      found = 1
      if ($7 == "Bluetooth" && tolower($0) ~ / torabo-tsuki s([[:space:]]|$)/) zmk_ble = 1
    }
    END { if (found) print (zmk_ble ? "zmk-ble" : "torabo") }
  ' <<<"$devices"
}

hide_hud() {
  if ! is_running; then
    printf 'idle\n' >"$CMD_FILE" 2>/dev/null || true
    exit 0
  fi
  printf 'hide\n' >"$CMD_FILE"
}

stop_daemon() {
  local pid
  if is_running; then
    # この設定の常駐プログラムだけに終了を通知し、残っている場合だけ停止する。
    printf 'quit\n' >"$CMD_FILE"
    pid="$(<"$PID_FILE")"
    sleep 0.1
    if is_hud_process "$pid"; then
      kill "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PID_FILE"
  printf 'idle\n' >"$CMD_FILE" 2>/dev/null || true
}

status_hud() {
  if is_running; then
    printf 'running pid=%s cmd=%s\n' "$(<"$PID_FILE")" "$(tr -d '\n' <"$CMD_FILE" 2>/dev/null || true)"
  else
    printf 'stopped\n'
  fi
}

main() {
  case "${1:-}" in
    show)
      case "${2:-}" in
        "") show_hud auto ;;
        jis|external|torabo) show_hud "$2" ;;
        *)
          usage >&2
          exit 1
          ;;
      esac
      ;;
    hide) hide_hud ;;
    start) start_daemon ;;
    stop) stop_daemon ;;
    status) status_hud ;;
    build) printf 'js hud daemon ready\n' ;;
    -h|--help) usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
