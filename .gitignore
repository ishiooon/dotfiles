# ===================================
# ホワイトリスト形式で管理するため全てのファイルを無視する
# ===================================
/*
/.*

# ===================================
# root
# ===================================
!/.zsh
/.zsh/env.local.zsh
!/.zshrc
!/.zshenv
!/.bash
# Claude 配下はローカルの設定、履歴、作業状態を含むため、共有する説明書以外を除外する。
!/.claude/
/.claude/*
/.claude/.*
!/.claude/CLAUDE.md
/.bash/env.local.bash
!/.bashrc
!/README.md
!.gitignore

# Toraboのビルドに使うワークフローだけを共有する。
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/torabo-zmk.yml

# ===================================
# .config
# ===================================
!/.config
/.config/*

!/.config/borders
!/.config/borders/**
!/.config/karabiner
!/.config/karabiner/**
# ToraboのZMKソースは共有し、復旧データとファームウェアの生成物は各端末で保管する。
!/.config/torabo-zmk/
/.config/torabo-zmk/*
!/.config/torabo-zmk/README.md
!/.config/torabo-zmk/build-local.sh
!/.config/torabo-zmk/config/
/.config/torabo-zmk/config/*
!/.config/torabo-zmk/config/*.conf
!/.config/torabo-zmk/config/*.dtsi
!/.config/torabo-zmk/config/*.keymap
!/.config/torabo-zmk/config/*.overlay
!/.config/torabo-zmk/config/west.yml
!/.config/nvim
!/.config/mcphub
!/.config/wezterm
!/.config/starship.toml
# Raycast の独自レビュー手順4件を共有し、配布された拡張本体と端末が生成するデータを除外する。
!/.config/raycast/
/.config/raycast/**
!/.config/raycast/extensions/
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/skills/
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/skills/github-pull-request-review/
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/skills/github-pull-request-review/SKILL.md
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/skills/github-pull-request-review/TOOLS.md
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/skills/github-pull-request-review/UPSTREAM.md
!/.config/raycast/extensions/89648e03-cceb-4205-9f40-75fcb039a4c6/skills/github-pull-request-review/VALIDATION.md
/.config/git
# Karabiner が端末ごとに書き出す自動バックアップは共有しない。
/.config/karabiner/automatic_backups/


# ===================================
# .bin
# ===================================
!/.bin
/.bin/*

!/.bin/install.sh
!/.bin/install-janky-borders.sh
!/.bin/install-karabiner.sh
!/.bin/karabiner-keymap-hud
!/.bin/bootstrap-macos.sh
!/.bin/install-wordpress-stubs.sh
# シェルの共通環境設定を、新しい端末への設定配布に含める。
!/.bin/shell-environment.sh
.config/nvim/lazy-lock.json
.config/nvim/intelephense.json
.config/lazygit/state.yml
.config/mcphub/servers.json

# ===================================
# .agents
# ===================================
!/.agents
/.agents/*
# Codex Skills の入口は dotfiles 側で管理し、必要なものだけを追跡する
!/.agents/skills
/.agents/skills/*

# ===================================
# tests
# ===================================
!/tests
!/tests/*.sh
!/tests/*.lua

# ===================================
# .codex
# ===================================
# Codex 配下は会話履歴、認証情報、キャッシュ、プラグインを含むため、共有する説明書以外を除外する。
!/.codex/
/.codex/*
/.codex/.*
!/.codex/AGENTS.md
# Codex の custom agent 定義だけを dotfiles として管理する。
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/*.toml
